{
  "name": "verdict",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios --device",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/__tests__/*.test.js\"",
    "build:web": "expo export --platform web --clear --output-dir dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.16",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.14",
    "expo-dev-client": "~57.0.15",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
